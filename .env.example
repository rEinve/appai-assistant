# Safe local default: no PayPal calls, deterministic demo responses.
PAYPAL_DEMO_MODE=fixture
APP_PORT=4300
STAGING_PORT=4200

# Local Compose database settings. These are development-only values.
# For installed PostgreSQL, update DATABASE_URL and set APP_USE_DOCKER_DB=false.
DATABASE_URL=postgresql://appai:appai-local-only@127.0.0.1:5432/appai_dev
APP_USE_DOCKER_DB=true
POSTGRES_PASSWORD=appai-local-only

# Required for member sign-in. Copy .env.example to .env and replace this with:
# openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:4300
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
WEB_APP_ORIGIN=http://localhost:4200
TRUSTED_ORIGINS=

# Optional AI-assisted extraction. The key stays on the API server; no AI calls
# are made until a member explicitly chooses Ask assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional member-initiated web search. This is read-only discovery, not a
# verified supplier catalogue, quote, or purchasing capability.
SEARCH_PROVIDER=serper
SERPER_API_KEY=

# Worker settings.
WORKER_POLL_MS=1000
WORKER_LEASE_MS=30000
WORKER_BATCH_SIZE=4

# Set PAYPAL_DEMO_MODE=sandbox only after creating a PayPal Developer sandbox app.
# Never commit real values or paste the client secret into chat.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_CURRENCY_SCALE=2
