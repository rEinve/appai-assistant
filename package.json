{
  "name": "appai-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-local.mjs",
    "start:web": "ng serve --host 0.0.0.0 --disable-host-check --live-reload=false",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:domain": "tsc -p tsconfig.domain.json",
    "test:domain": "npm run build:domain && node --test packages/domain/test/domain.test.js",
    "test:m1:workflow": "npm run build:api && npm run build:worker && node --env-file-if-exists=.env scripts/test-m1-fixture-workflow.mjs",
    "build:api": "tsc -p tsconfig.api.json",
    "build:worker": "tsc -p tsconfig.worker.json",
    "test:paypal": "npm run build:api && node --test packages/adapters/paypal-sandbox/test/paypal.test.js",
    "test:paypal:sandbox": "npm run build:api && node --env-file-if-exists=.env scripts/test-paypal-sandbox.mjs",
    "start:api": "node --env-file-if-exists=.env dist/api/apps/api/src/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker/apps/worker/src/worker.js",
    "demo:api": "npm run build:api && npm run start:api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-local.mjs",
    "invite:member": "node --env-file-if-exists=.env scripts/create-member-invite.mjs",
    "test:auth": "npm run build:api && node --env-file-if-exists=.env scripts/test-member-auth.mjs",
    "test:assistant:live": "npm run build:api && node --env-file-if-exists=.env scripts/test-assistant-refinement.mjs",
    "test:search:live": "npm run build:api && node --env-file-if-exists=.env scripts/test-search-live.mjs"
  },
  "dependencies": {
    "@angular/animations": "18.2.12",
    "@angular/common": "18.2.12",
    "@angular/compiler": "18.2.12",
    "@angular/core": "18.2.12",
    "@angular/forms": "18.2.12",
    "@angular/platform-browser": "18.2.12",
    "@angular/platform-browser-dynamic": "18.2.12",
    "@angular/router": "18.2.12",
    "better-auth": "1.7.14",
    "pg": "8.23.1",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "zone.js": "0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "18.2.12",
    "@angular/cli": "18.2.12",
    "@angular/compiler-cli": "18.2.12",
    "@types/jasmine": "5.1.4",
    "@types/node": "22.10.2",
    "@types/pg": "8.15.5",
    "jasmine-core": "5.4.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.5.4"
  }
}
